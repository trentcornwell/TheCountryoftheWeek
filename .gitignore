# Operating systems and editors
.DS_Store
Thumbs.db
Desktop.ini
*.code-workspace
.idea/
.vscode/*.local.json

# Secrets and local environment
.env
.env.*
!.env.example
wp-config.php
auth.json
*.pem
*.key

# WordPress runtime content
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/backup*/
*.sql
*.sql.gz

# Dependencies and build output. Anchored to the repo root (leading
# slash) so this only matches the root Composer vendor/ directory, not
# theme/country-week/includes/vendor/ — that one is hand-vendored,
# committed library code (the QR generator, bundled fonts), not a
# regenerable dependency install. An unanchored rule here previously
# made it invisible to git entirely, so every deployed release has been
# silently shipping without it (breaking the PDF download and leaving
# the presentation slide's text unrendered) since whichever commit
# first added those features.
/vendor/
node_modules/
coverage/
dist/
build/
*.log

# Local verification-only WordPress install (see docs/SETUP.md)
.wp-local/
*.phar
.phpunit.result.cache

# Scratch cache used when re-importing CIA Factbook data (see scripts/)
.import-tmp/

# Cached source data for scripts/build-country-maps.py (re-downloadable)
.cache/

# Generated exports (retain documentation)
exports/*
!exports/README.md

# Temporary files
*.tmp
*.swp
*.swo
~*

